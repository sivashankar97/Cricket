rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Guests (anonymous sign-in) may only use the Play tab; see play_games.
    function isGuest() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function signedIn() {
      return request.auth != null && !isGuest();
    }

    // Everything except auctions, their photos and private contact details:
    // any signed-in user.
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && !(collection in ['auctions', 'photos', 'user_private',
                            'phone_index', 'player_claims', 'users']);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }
    function createdBy(data) {
      return data.get('created_by', '');
    }
    function isAuctionAdminFor(data) {
      return data.get('auction_id', '') != ''
        && request.auth.uid in auctionAdmins(data.auction_id);
    }

    // Profiles. Signed-up accounts (no created_by) only change themselves;
    // players added by an organizer (created_by) or an auction stay editable
    // by organizers, whose team roles the rules can't check.
    match /users/{userId} {
      allow create: if signedIn()
        && (request.auth.uid == userId
            || createdBy(request.resource.data) == request.auth.uid
            || isAuctionAdminFor(request.resource.data));
      allow update: if signedIn()
        && createdBy(request.resource.data) == createdBy(resource.data)
        && (request.auth.uid == userId
            || createdBy(resource.data) != ''
            || (request.resource.data.get('auction_id', '')
                  == resource.data.get('auction_id', '')
                && isAuctionAdminFor(resource.data)));
      allow delete: if signedIn()
        && (request.auth.uid == userId
            || createdBy(resource.data) == request.auth.uid);
    }
    // Career stats are written by whoever scores the match; sessions by the app.
    match /users/{userId}/{sub}/{document=**} {
      allow read, write: if signedIn();
    }

    // A player's mobile number: only they can read or change it.
    match /user_private/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Hashed mobile number -> player id. Exact lookups only (no listing).
    // An entry points at yourself or at a player you added; it only moves to
    // another account together with an approved claim (same batch).
    match /phone_index/{key} {
      allow get: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['user_id', 'created_by', 'updated_at'])
        && request.resource.data.created_by == request.auth.uid
        && (request.resource.data.user_id == request.auth.uid
            || createdBy(getAfter(userPath(request.resource.data.user_id)).data)
                 == request.auth.uid);
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['user_id', 'created_by', 'updated_at'])
        && resource.data.created_by == request.auth.uid
        && request.resource.data.created_by == request.resource.data.user_id
        && getAfter(/databases/$(database)/documents/player_claims/$(resource.data.user_id + '_' + request.resource.data.user_id)).data.status == 'approved';
      allow delete: if signedIn()
        && (resource.data.user_id == request.auth.uid
            || resource.data.created_by == request.auth.uid);
    }

    // "That added player is me" requests; the organizer approves or declines.
    // Asking needs the number's index key, so you can only claim the player
    // your own number points at.
    match /player_claims/{claimId} {
      allow get: if signedIn()
        && (claimId.matches('.*_' + request.auth.uid)
            || resource.data.organizer_id == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.claimant_id == request.auth.uid
            || resource.data.organizer_id == request.auth.uid);
      allow create: if signedIn()
        && claimId == request.resource.data.player_id + '_' + request.auth.uid
        && request.resource.data.claimant_id == request.auth.uid
        && request.resource.data.player_id != request.auth.uid
        && request.resource.data.status in ['pending', 'dismissed']
        && get(/databases/$(database)/documents/phone_index/$(request.resource.data.phone_key)).data.user_id
             == request.resource.data.player_id
        && request.resource.data.organizer_id
             == createdBy(get(userPath(request.resource.data.player_id)).data);
      allow update: if signedIn()
        && resource.data.organizer_id == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updated_at'])
        && request.resource.data.status in ['approved', 'declined'];
    }

    match /matches/{document=**} {
      allow read: if true;
    }
    match /teams/{document=**} {
      allow read: if true;
    }
    match /tournaments/{document=**} {
      allow read: if true;
    }
    match /innings/{document=**} {
      allow read: if true;
    }
    match /ball_scores/{document=**} {
      allow read: if true;
    }
    match /match_events/{document=**} {
      allow read: if true;
    }
    match /partnerships/{document=**} {
      allow read: if true;
    }
    match /leaderboard/{document=**} {
      allow read: if true;
    }
    match /users/{userId} {
      allow read: if true;
    }
    // Shared CricketData.org cache for the Home "Global cricket" section.
    match /global_cricket/{document=**} {
      allow read: if true;
    }
    match /users/{userId}/user_stat/{document=**} {
      allow read: if true;
    }

    // Play tab scores: guests read the leaderboard and save their own solo /
    // daily games, always under the name "Guest" (no challenges).
    match /play_games/{gameId} {
      allow read: if isGuest();
      allow create: if isGuest()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.user_name == 'Guest'
        && request.resource.data.user_image == null
        && request.resource.data.challenge_id == null;
    }

    // Player auctions: published ones are public; drafts only for admins.
    // Only the auction's admins can change it; only the creator can change
    // the admin list or delete it.
    function auctionAdmins(auctionId) {
      return get(/databases/$(database)/documents/auctions/$(auctionId)).data.admin_ids;
    }

    match /auctions/{auctionId} {
      allow read: if resource.data.status in ['upcoming', 'live', 'paused', 'completed']
        || (signedIn() && request.auth.uid in resource.data.admin_ids);
      allow create: if signedIn()
        && request.resource.data.created_by == request.auth.uid
        && request.auth.uid in request.resource.data.admin_ids
        && request.resource.data.status == 'draft';
      allow update: if signedIn()
        && request.auth.uid in resource.data.admin_ids
        && request.resource.data.created_by == resource.data.created_by
        && (request.resource.data.admin_ids == resource.data.admin_ids
            || request.auth.uid == resource.data.created_by);
      allow delete: if signedIn() && request.auth.uid == resource.data.created_by;

      // getAfter: the first entry is written in the batch that creates the auction.
      match /log/{entryId} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid in
          getAfter(/databases/$(database)/documents/auctions/$(auctionId)).data.admin_ids;
        allow delete: if signedIn() && request.auth.uid ==
          get(/databases/$(database)/documents/auctions/$(auctionId)).data.created_by;
      }
    }

    // Compressed player / banner photos for auctions.
    match /photos/{photoId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid in auctionAdmins(request.resource.data.auction_id);
      allow delete: if signedIn()
        && request.auth.uid in auctionAdmins(resource.data.auction_id);
    }
  }
}

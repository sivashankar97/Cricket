# Copy to khelo/whatsapp_login/.env (git-ignored) and fill in. Never commit the real file.
# From Meta: developers.facebook.com → your app → WhatsApp → API Setup
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# From Meta: App settings → Basic → App secret
WA_APP_SECRET=
# Any long random text; paste the same value into Meta's webhook "Verify token"
WA_VERIFY_TOKEN=
# Optional
WA_GRAPH_VERSION=v23.0
APP_URL=https://sportstamil.network
FIREBASE_SERVICE_ACCOUNT_FILE=/run/secrets/firebase-admin.json
